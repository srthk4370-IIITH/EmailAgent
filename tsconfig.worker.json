  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist-worker",
    "rootDir": "src",
    "module": "commonjs",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/worker/worker.ts"
  ]
}
