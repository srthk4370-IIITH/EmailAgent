{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmailAgent Desktop",
  "version": "1.0.0",
  "identifier": "com.emailagent.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../desktop/web-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EmailAgent",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "AI email desktop wrapper",
    "longDescription": "Desktop wrapper for the EmailAgent Next.js and worker runtime"
  }
}
